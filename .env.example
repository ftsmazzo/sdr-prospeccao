# App
APP_ENV=development
# Gere um secret longo localmente / no EasyPanel — NÃO commite o valor real
WEBHOOK_SECRET=
# false = aceita e loga aviso; true = 401 se secret inválido
WEBHOOK_SECRET_ENFORCE=false

# Nome/gênero da atendente no WhatsApp (projeto interno continua Edu SDR)
AGENT_NAME=Edu
AGENT_GENDER=f

# Database / cache (EasyPanel internal hostnames after provision)
DATABASE_URL=postgresql://edu:CHANGE_ME@postgres:5432/edu
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

PUBLIC_BASE_URL=https://sdr-prospeccao-api.kxryyk.easypanel.host

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
STT_MODEL=openai/whisper-1

# Evolution API
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# false = OGG Opus sem re-encode (padrão p/ nota de voz já processada); true = Evolution re-encoda
EVOLUTION_AUDIO_ENCODING=false

# ElevenLabs (Roberta - For Conversational / eleven_v4)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=1.0

# Cadência humana (ms)
HUMAN_IDLE_MIN_MS=10000
HUMAN_IDLE_MAX_MS=15000
TYPING_MIN_MS=2500
TYPING_MAX_MS=6000

# Debounce de mensagens picadas (segundos)
INBOUND_DEBOUNCE_SECONDS=7

# Follow-up contrato (segundos; 900 = 15 min)
FOLLOWUP_DELAY_SECONDS=900
