# App
APP_ENV=development
WEBHOOK_SECRET=change-me

# Database / cache (EasyPanel internal hostnames after provision)
# Hostnames internos EasyPanel (senha no painel do serviço)
DATABASE_URL=postgresql://edu:CHANGE_ME@postgres:5432/edu
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# App público (links de checkout)
PUBLIC_BASE_URL=https://sdr-prospeccao-api.kxryyk.easypanel.host

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
STT_MODEL=openai/whisper-1

# Evolution API
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=0.95

# Delay humanizado (ms)
REPLY_DELAY_MIN_MS=3200
REPLY_DELAY_MAX_MS=7000
